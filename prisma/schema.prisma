datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // ADMIN, COUNSELLOR, BRAHMACHARI, STUDENT
  cardType     String   @default("STUDENT_S2") // BRAHMACHARI_S1, STUDENT_S2
  phone        String?
  avatarUrl    String?

  // Hierarchy relationships:
  counsellorId String?  @db.ObjectId
  counsellor   User?    @relation("CounsellorBrahmacharis", fields: [counsellorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brahmacharis User[]   @relation("CounsellorBrahmacharis")

  preacherId   String?  @db.ObjectId
  preacher     User?    @relation("PreacherStudents", fields: [preacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students     User[]   @relation("PreacherStudents")

  sadhanaEntries SadhanaEntry[]
  targetOverrides SadhanaRuleOverride[] @relation("TargetUserOverrides")
  createdOverrides SadhanaRuleOverride[] @relation("CreatedOverrides")
  auditLogsReceived SadhanaRuleAuditLog[] @relation("AuditTargetUser")
  auditLogsPerformed SadhanaRuleAuditLog[] @relation("AuditPerformedBy")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SadhanaEntry {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               String   // YYYY-MM-DD format (timezone normalized)
  
  // Raw Nidra Inputs
  sleepBedTime       String?  // e.g., "22:05" (24-hr format HH:mm)
  wakeUpTime         String?  // e.g., "03:45" (24-hr format HH:mm)
  daySleepMinutes    Int?     @default(0)

  // Raw Japa Input
  japaCompletionTime String?  // e.g., "07:10" (24-hr format HH:mm)
  japaRoundsCount    Int?     @default(16)

  // Raw Attendance Inputs ("ON_TIME", "LATE", "ABSENT", "SEVA_EXCUSED")
  mangalAarti        String?  // ON_TIME, LATE, ABSENT, SEVA_EXCUSED
  guruPuja           String?  // ON_TIME, LATE, ABSENT, SEVA_EXCUSED (for S1)
  sbClass            String?  // ON_TIME, LATE, ABSENT, SEVA_EXCUSED
  prasadam           String?  // ON_TIME, LATE, ABSENT, SEVA_EXCUSED

  // Raw Duration Inputs (in minutes)
  pathanMinutes      Int?     @default(0)
  pathanBookName     String?
  sravanMinutes      Int?     @default(0)
  sravanLectureTopic String?

  // Raw Office Input (BACE students)
  officeOutTime      String?  // e.g. "09:00"
  officeInTime       String?  // e.g. "18:30"

  // Raw Seva Breakdown (minutes)
  sevaPreaching      Int?     @default(0)
  sevaManagement     Int?     @default(0)
  sevaLecturePrep    Int?     @default(0)
  sevaMenial         Int?     @default(0)
  sevaHarinamBook    Int?     @default(0)
  sevaAdhocTravel    Int?     @default(0)
  sevaMisc           Int?     @default(0)
  sevaNotes          String?

  // Seva Bhavana (JSON string array of selected codes)
  bhavanaNegativeTags String? // e.g. '["E", "M"]'
  bhavanaPositiveTags String? // e.g. '["NTU", "D"]'
  personalNotes       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, date])
}

model RuleConfig {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String   // JSON containing scoring thresholds, targets, weights, override limits
  updatedAt   DateTime @updatedAt
}

model SadhanaRuleOverride {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  ruleKey          String   // BED_TIME, WAKE_UP_TIME, DAY_SLEEP_LIMIT, JAPA_TARGET_TIME, PATHAN_WEEKLY_HOURS, SRAVAN_WEEKLY_HOURS, SEVA_WEEKLY_HOURS
  targetUserId     String   @db.ObjectId
  targetUser       User     @relation("TargetUserOverrides", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetRole       String   // STUDENT, BRAHMACHARI
  createdById      String   @db.ObjectId
  createdBy        User     @relation("CreatedOverrides", fields: [createdById], references: [id], onDelete: Cascade)
  createdByRole    String   // COUNSELLOR, BRAHMACHARI, ADMIN
  originalValue    String   // e.g. "22:00" or "3.5"
  overrideValue    String   // e.g. "22:15" or "4.0"
  allowedDeviation String?  // e.g. "+/- 15 mins"
  reason           String   // Mandatory reason for override
  effectiveFrom    String   // YYYY-MM-DD
  effectiveUntil   String?  // YYYY-MM-DD (null = open-ended)
  status           String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([targetUserId, status])
  @@index([targetUserId, ruleKey, status])
}

model SadhanaRuleAuditLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  action         String   // SADHANA_RULE_OVERRIDE_CREATED, SADHANA_RULE_OVERRIDE_UPDATED, SADHANA_RULE_OVERRIDE_REVOKED
  performedById  String   @db.ObjectId
  performedBy    User     @relation("AuditPerformedBy", fields: [performedById], references: [id], onDelete: Cascade)
  targetUserId   String   @db.ObjectId
  targetUser     User     @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  ruleKey        String
  oldValue       String?
  newValue       String?
  reason         String?
  effectiveFrom  String?
  effectiveUntil String?
  metadata       String?  // JSON string of additional details
  createdAt      DateTime @default(now())

  @@index([targetUserId])
  @@index([performedById])
}
